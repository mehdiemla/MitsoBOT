[Unit]
Description=Mitso Telegram Mini App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/mitso
ExecStart=/root/mitso/.venv/bin/python /root/mitso/web_app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
